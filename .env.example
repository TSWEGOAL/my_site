# 复制为 .env 并填入真实值
# 注意：.env 已加入 .gitignore，不要提交到仓库

# Flask session 加签密钥（生产环境必须改成随机长串）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=替换成随机生成的长字符串

# 管理员账号（init_db.py 读取）
#   - 同时设置 USERNAME + PASSWORD → 强制 upsert：账号存在则覆盖密码，不存在则创建
#   - 只设 USERNAME 不设 PASSWORD → 首次随机密码创建，已存在跳过
#   - 都不设 → 默认创建 admin 账号 + 随机密码（仅首次）
# 重置现有管理员的密码：在 .env 里写 ADMIN_USERNAME=<你的账号> ADMIN_PASSWORD=<新密码>，再跑 python init_db.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=替换成强密码

# 强制 session cookie 只走 HTTPS（部署到 Render 等 HTTPS 平台时设 1）
HTTPS_ONLY=0

# 数据库连接串。留空 = 用本地 SQLite（instance/site.db，注意托管平台重启会清空）
# Render Postgres / Neon / Supabase 都填这里，格式：
#   postgresql://user:password@host/dbname
# 用了 Postgres 记得在 requirements.txt 里打开 psycopg[binary] 那行
# DATABASE_URL=
